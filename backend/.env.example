# Database Configuration
DATABASE_URL=jdbc:postgresql://localhost:5433/deligh_campus
DATABASE_USERNAME=deligh_campus
DATABASE_PASSWORD=your_database_password
DB_CONNECTION_POOL_SIZE=10
DB_CONNECTION_TIMEOUT_MS=30000

# Security Configuration
JWT_SECRET=your_jwt_secret_minimum_32_characters
JWT_EXPIRATION=86400000
SESSION_TIMEOUT_MS=1800000

# Server Configuration
SERVER_PORT=8081
APP_NAME=Deligh Campus API
APP_VERSION=1.0.0
APP_ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# JPA Configuration
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=true

# Error Handling
ERROR_INCLUDE_MESSAGE=never
ERROR_INCLUDE_STACKTRACE=never
ERROR_INCLUDE_EXCEPTION=false

# Management Endpoints
MANAGEMENT_ENDPOINTS=health,info
HEALTH_SHOW_DETAILS=when-authorized

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=*
CORS_ALLOW_CREDENTIALS=true