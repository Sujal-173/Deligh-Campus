# Backend API Configuration
BACKEND_API_URL=http://localhost:8081/api/v1
BACKEND_REQUEST_TIMEOUT_MS=15000

# Security Configuration
ROLE_COOKIE_SECRET=your_cookie_secret_minimum_32_characters
SESSION_COOKIE_NAME=deligh_session
REFRESH_COOKIE_NAME=deligh_refresh
ROLE_COOKIE_NAME=deligh_role
SESSION_REMEMBER_MAX_AGE_SECONDS=604800

# Application Configuration
NEXT_PUBLIC_APP_NAME=Deligh Campus
NEXT_PUBLIC_APP_TAGLINE=Built for Smarter Education.
NEXT_PUBLIC_SUPPORT_EMAIL=support@delighcampus.com
NEXT_PUBLIC_API_PROXY_PATH=/api/backend
NEXT_PUBLIC_API_TIMEOUT_MS=15000

# Environment Configuration
NODE_ENV=development
NEXT_PUBLIC_APP_ENVIRONMENT=development

# Feature Flags
NEXT_PUBLIC_ENABLE_SOCIAL_LOGIN=true
NEXT_PUBLIC_ENABLE_EMAIL_VERIFICATION=true
NEXT_PUBLIC_ENABLE_FORGOT_PASSWORD=true

# Google OAuth Configuration
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id

# Performance Configuration
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_ERROR_REPORTING=false